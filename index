    private static CourtRepository courts(Function<Invocation, Object> handler) {
        return proxy(CourtRepository.class, handler);
    }

    private static BookingRepository bookings(Function<Invocation, Object> handler) {
        return proxy(BookingRepository.class, handler);
    }

    private static UserRepository users(Function<Invocation, Object> handler) {
        return proxy(UserRepository.class, handler);
    }

    private static PenaltyRepository penalties(Function<Invocation, Object> handler) {
        return proxy(PenaltyRepository.class, handler);
    }

    private static <T> T proxy(Class<T> type, Function<Invocation, Object> handler) {
        InvocationHandler invocationHandler = (proxy, method, args) -> {
            if (method.getDeclaringClass() == Object.class) {
                return switch (method.getName()) {
                    case "toString" -> type.getSimpleName() + "Proxy";
                    case "hashCode" -> System.identityHashCode(proxy);
                    case "equals" -> proxy == args[0];
                    default -> null;
                };
            }
            Object result = handler.apply(new Invocation(method.getName(), method.getReturnType(), args == null ? new Object[0] : args));
            if (result == null) {
                return defaultValue(method.getReturnType());
            }
            return result;
        };
        return type.cast(Proxy.newProxyInstance(type.getClassLoader(), new Class<?>[] { type }, invocationHandler));
    }

    private record Invocation(String method, Class<?> methodReturnType, Object[] args) {
        @SuppressWarnings("unchecked")
        <T> T argument(int index) { return (T) args[index]; }
    }

    private static Object defaultValue(Class<?> type) {
        if (!type.isPrimitive()) return null;
        if (type == boolean.class) return false;
        if (type == byte.class) return (byte) 0;
        if (type == short.class) return (short) 0;
        if (type == int.class) return 0;
        if (type == long.class) return 0L;
        if (type == float.class) return 0f;
        if (type == double.class) return 0d;
        if (type == char.class) return '\0';
        return null;
    }
}
